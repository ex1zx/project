{
  "expo": {
    "name": "Hand Gesture Detector",
    "slug": "project",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "project",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "android": {
      "package": "com.project.handgesture",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "يحتاج التطبيق إلى الكاميرا للكشف عن إيماءات اليد",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "21c21f2a-3568-4ec5-848f-302098834c2d"
      }
    },
    "owner": "executioner-exec"
  }
}
